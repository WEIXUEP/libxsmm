{
  "version": 4,
  "configurePresets": [
    {
      "name": "win",
      "generator": "NMake Makefiles JOM",
      "binaryDir": "${sourceDir}/build-win",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-win/install",
        "XSMM_STATIC": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "win", "configurePreset": "win", "jobs": 8 }
  ]
}
